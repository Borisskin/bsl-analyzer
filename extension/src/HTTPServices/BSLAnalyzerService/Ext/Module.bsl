// BSL Analyzer - HTTP-сервис для выполнения запросов к базе 1С
// Версия: 1.0.0

#Область СлужебныеПроцедурыИФункции

// Десериализует строку JSON в значение 1С.
//
// Параметры:
//   СтрокаJSON - Строка - строка в формате JSON
//
// Возвращаемое значение:
//   Произвольный - десериализованное значение
//
Функция РазобратьJSON(СтрокаJSON)
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Результат = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	Возврат Результат;
КонецФункции

// Сериализует значение 1С в строку JSON.
//
// Параметры:
//   Значение - Произвольный - значение для сериализации
//
// Возвращаемое значение:
//   Строка - строка в формате JSON
//
Функция СформироватьJSON(Значение)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

// Формирует успешный HTTP-ответ с JSON-телом.
//
// Параметры:
//   Значение - Произвольный - значение для тела ответа
//
// Возвращаемое значение:
//   HTTPСервисОтвет - ответ с кодом 200
//
Функция ОтветJSON(Значение)
	КодУспешно = 200;
	Ответ = Новый HTTPСервисОтвет(КодУспешно);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СформироватьJSON(Значение));
	Возврат Ответ;
КонецФункции

// Формирует HTTP-ответ с ошибкой.
//
// Параметры:
//   КодСостояния - Число - HTTP-код состояния
//   ТекстОшибки  - Строка - описание ошибки
//
// Возвращаемое значение:
//   HTTPСервисОтвет - ответ с указанным кодом ошибки
//
Функция ОтветОшибка(КодСостояния, ТекстОшибки)
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки("{""error"": """ + ТекстОшибки + """}");
	Возврат Ответ;
КонецФункции

// Приводит значение к типу, пригодному для сериализации в JSON.
//
// Параметры:
//   Значение - Произвольный - исходное значение
//
// Возвращаемое значение:
//   Произвольный - значение, пригодное для JSON
//
Функция ПривестиЗначениеКJSON(Значение)
	Если Значение = Неопределено ИЛИ Значение = NULL Тогда
		Возврат "";
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	// Примитивы - передаём как есть
	Если ТипЗначения = Тип("Число")
		ИЛИ ТипЗначения = Тип("Булево")
		ИЛИ ТипЗначения = Тип("Строка")
		ИЛИ ТипЗначения = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;

	// Массив - рекурсивно обрабатываем элементы
	Если ТипЗначения = Тип("Массив") ИЛИ ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ПривестиЗначениеКJSON(Элемент));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Структура - рекурсивно обрабатываем значения
	Если ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого КлючИЗначение Из Значение Цикл
			Результат.Вставить(КлючИЗначение.Ключ, ПривестиЗначениеКJSON(КлючИЗначение.Значение));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Соответствие - рекурсивно, ключи тоже приводим
	Если ТипЗначения = Тип("Соответствие") ИЛИ ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		Результат = Новый Соответствие;
		Для Каждого КлючИЗначение Из Значение Цикл
			Результат.Вставить(Строка(КлючИЗначение.Ключ), ПривестиЗначениеКJSON(КлючИЗначение.Значение));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Всё остальное (ссылки, объекты, ТаблицаЗначений и т.д.) - в строковое представление
	Возврат Строка(Значение);
КонецФункции

// Преобразует ISO-8601 строку в значение Дата.
// Извлекает цифры и дополняет до формата ГГГГММДДЧЧММСС, поэтому принимает
// как "2026-07-05", так и "2026-07-05T14:30:00".
//
// Параметры:
//   Текст - Строка - строка даты в формате ISO-8601
//
// Возвращаемое значение:
//   Дата, Неопределено - разобранная дата либо Неопределено при нехватке цифр
//
Функция ДатаИзISO(Знач Текст)
	Цифры = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;

	ДлинаДаты = 8;
	Если СтрДлина(Цифры) < ДлинаДаты Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДлинаДатыВремени = 14;
	Цифры = Лев(Цифры + "000000000000000", ДлинаДатыВремени);
	Возврат Дата(Цифры);
КонецФункции

// Сопоставляет имя уровня (рус/англ) значению перечисления УровеньЖурналаРегистрации.
//
// Параметры:
//   Имя - Строка - имя уровня журнала регистрации
//
// Возвращаемое значение:
//   УровеньЖурналаРегистрации, Неопределено - уровень либо Неопределено для нераспознанного имени
//
Функция УровеньЖурналаПоИмени(Знач Имя)
	ИмяВРег = ВРег(СокрЛП(Имя));
	Если ИмяВРег = "ИНФОРМАЦИЯ" ИЛИ ИмяВРег = "INFORMATION" Тогда
		Возврат УровеньЖурналаРегистрации.Информация;
	ИначеЕсли ИмяВРег = "ПРЕДУПРЕЖДЕНИЕ" ИЛИ ИмяВРег = "WARNING" Тогда
		Возврат УровеньЖурналаРегистрации.Предупреждение;
	ИначеЕсли ИмяВРег = "ОШИБКА" ИЛИ ИмяВРег = "ERROR" Тогда
		Возврат УровеньЖурналаРегистрации.Ошибка;
	ИначеЕсли ИмяВРег = "ПРИМЕЧАНИЕ" ИЛИ ИмяВРег = "NOTE" Тогда
		Возврат УровеньЖурналаРегистрации.Примечание;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Строит структуру отбора для ВыгрузитьЖурналРегистрации из параметров запроса.
//
// Параметры:
//   Параметры - Структура - разобранное JSON-тело запроса
//
// Возвращаемое значение:
//   Структура - отбор журнала регистрации (пустой, если фильтры не заданы)
//
Функция ПостроитьОтборЖурнала(Знач Параметры)
	Отбор = Новый Структура;

	Если Параметры.Свойство("date_from") И ЗначениеЗаполнено(Параметры.date_from) Тогда
		ДатаНачала = ДатаИзISO(Параметры.date_from);
		Если ДатаНачала <> Неопределено Тогда
			Отбор.Вставить("ДатаНачала", ДатаНачала);
		КонецЕсли;
	КонецЕсли;
	Если Параметры.Свойство("date_to") И ЗначениеЗаполнено(Параметры.date_to) Тогда
		ДатаОкончания = ДатаИзISO(Параметры.date_to);
		Если ДатаОкончания <> Неопределено Тогда
			Отбор.Вставить("ДатаОкончания", ДатаОкончания);
		КонецЕсли;
	КонецЕсли;
	Если Параметры.Свойство("level") И ЗначениеЗаполнено(Параметры.level) Тогда
		Уровень = УровеньЖурналаПоИмени(Параметры.level);
		Если Уровень <> Неопределено Тогда
			Отбор.Вставить("Уровень", Уровень);
		КонецЕсли;
	КонецЕсли;
	Если Параметры.Свойство("user") И ЗначениеЗаполнено(Параметры.user) Тогда
		Отбор.Вставить("Пользователь", Параметры.user);
	КонецЕсли;
	Если Параметры.Свойство("event") И ЗначениеЗаполнено(Параметры.event) Тогда
		Отбор.Вставить("Событие", Параметры.event);
	КонецЕсли;
	Если Параметры.Свойство("metadata") И ЗначениеЗаполнено(Параметры.metadata) Тогда
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Параметры.metadata);
		Если ОбъектМетаданных = Неопределено Тогда
			ВызватьИсключение "Объект метаданных не найден: " + Параметры.metadata;
		КонецЕсли;
		Отбор.Вставить("Метаданные", ОбъектМетаданных);
	КонецЕсли;

	Возврат Отбор;
КонецФункции

// Собирает текстовое поле строки журнала для пост-фильтра contains (в верхнем регистре).
//
// Параметры:
//   СтрокаТаблицы - СтрокаТаблицыЗначений - строка выгруженного журнала регистрации
//
// Возвращаемое значение:
//   Строка - объединённые комментарий, данные и представления в верхнем регистре
//
Функция ТекстДляПоиска(Знач СтрокаТаблицы)
	Комментарий = Строка(СтрокаТаблицы.Комментарий);
	ПредставлениеДанных = Строка(СтрокаТаблицы.ПредставлениеДанных);
	Данные = Строка(СтрокаТаблицы.Данные);
	ПредставлениеСобытия = Строка(СтрокаТаблицы.ПредставлениеСобытия);
	ПредставлениеМетаданных = Строка(СтрокаТаблицы.ПредставлениеМетаданных);
	Возврат ВРег(Комментарий + " " + ПредставлениеДанных + " " + Данные + " "
		+ ПредставлениеСобытия + " " + ПредставлениеМетаданных);
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Выполняет SELECT-запрос к базе данных 1С.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий HTTP-запрос с JSON-телом:
//     * query      - Строка - текст запроса (SELECT/ВЫБРАТЬ)
//     * limit      - Число  - максимальное количество строк (по умолчанию 100, макс 1000)
//     * parameters - Структура - параметры запроса (необязательно)
//
// Возвращаемое значение:
//   HTTPСервисОтвет - JSON с полями: columns, rows, total, truncated
//
Функция ЗапросPOST(Запрос)
	Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());

	ТекстЗапроса = Параметры.query;

	ЛимитПоУмолчанию = 100;
	МаксимальныйЛимит = 1000;
	Лимит = ЛимитПоУмолчанию;
	Если Параметры.Свойство("limit") И Параметры.limit > 0 Тогда
		Лимит = Мин(Параметры.limit, МаксимальныйЛимит);
	КонецЕсли;

	ДлинаПрефикса = 10;
	ДлинаВыбрать = 7;
	ДлинаSelect = 6;
	КодОшибкиЗапроса = 400;

	Префикс = ВРег(СокрЛП(Лев(ТекстЗапроса, ДлинаПрефикса)));
	Если Лев(Префикс, ДлинаВыбрать) <> "ВЫБРАТЬ" И Лев(Префикс, ДлинаSelect) <> "SELECT" Тогда
		Возврат ОтветОшибка(КодОшибкиЗапроса, "Only SELECT queries allowed");
	КонецЕсли;

	Попытка
		Запрос1С = Новый Запрос(ТекстЗапроса);

		Если Параметры.Свойство("parameters") И ТипЗнч(Параметры.parameters) = Тип("Структура") Тогда
			Для Каждого КлючИЗначение Из Параметры.parameters Цикл
				Запрос1С.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			КонецЦикла;
		КонецЕсли;

		РезультатЗапроса = Запрос1С.Выполнить();
	Исключение
		Возврат ОтветОшибка(КодОшибкиЗапроса, ОписаниеОшибки());
	КонецПопытки;

	Выборка = РезультатЗапроса.Выбрать();

	Колонки = Новый Массив;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;

	Строки = Новый Массив;
	Счетчик = 0;
	Усечено = Ложь;
	Пока Выборка.Следующий() Цикл
		Если Счетчик >= Лимит Тогда
			Усечено = Истина;
			Прервать;
		КонецЕсли;
		Строка = Новый Массив;
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			Строка.Добавить(ПривестиЗначениеКJSON(Выборка[Колонка.Имя]));
		КонецЦикла;
		Строки.Добавить(Строка);
		Счетчик = Счетчик + 1;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("total", Счетчик);
	Результат.Вставить("truncated", Усечено);

	Возврат ОтветJSON(Результат);
КонецФункции

// Возвращает версию расширения для проверки связи.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий HTTP-запрос
//
// Возвращаемое значение:
//   HTTPСервисОтвет - JSON с полем version
//
Функция ВерсияGET(Запрос) // NOSONAR
	Результат = Новый Структура;
	Результат.Вставить("version", "1.1.0");

	Возврат ОтветJSON(Результат);
КонецФункции

// Проверяет синтаксис запроса 1С через СхемаЗапроса.
// Платформа парсит и валидирует запрос без выполнения.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий HTTP-запрос с JSON-телом:
//     * query - Строка - текст запроса для проверки
//
// Возвращаемое значение:
//   HTTPСервисОтвет - JSON с полями: valid, errors
//
Функция ПроверкаЗапросаPOST(Запрос)
	Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());

	ТекстЗапроса = Параметры.query;
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат ОтветОшибка(400, "query is required");
	КонецЕсли;

	Ошибки = Новый Массив;
	Результат = Новый Структура;

	Попытка
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
		СхемаЗапроса.ПолучитьТекстЗапроса();

		Результат.Вставить("valid", Истина);
		Результат.Вставить("errors", Ошибки);
	Исключение
		Результат.Вставить("valid", Ложь);
		Ошибки.Добавить(ОписаниеОшибки());
		Результат.Вставить("errors", Ошибки);
	КонецПопытки;

	Возврат ОтветJSON(Результат);
КонецФункции

// Проверяет синтаксис BSL-кода без выполнения.
// Код оборачивается в "Если Ложь Тогда ... КонецЕсли" и передается в Выполнить().
// Платформа компилирует весь код (проверяя синтаксис), но не выполняет его.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий HTTP-запрос с JSON-телом:
//     * code - Строка - BSL-код для проверки синтаксиса
//
// Возвращаемое значение:
//   HTTPСервисОтвет - JSON с полями: valid, error (при наличии ошибки)
//
Функция ПроверкаСинтаксисаPOST(Запрос)
	КодОшибкиЗапроса = 400;

	Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());

	Если Не Параметры.Свойство("code") ИЛИ Не ЗначениеЗаполнено(Параметры.code) Тогда
		Возврат ОтветОшибка(КодОшибкиЗапроса, "Empty code");
	КонецЕсли;

	// Оборачиваем код в недостижимый блок: платформа проверит синтаксис при компиляции,
	// но не выполнит код благодаря условию Ложь
	ТекстДляПроверки = "Если Ложь Тогда
	|" + Параметры.code + "
	|КонецЕсли;";

	Результат = Новый Структура;
	Попытка
		Выполнить(ТекстДляПроверки); // BSLLS:ExecuteExternalCode-off
		Результат.Вставить("valid", Истина);
	Исключение
		Результат.Вставить("valid", Ложь);
		Результат.Вставить("error", ОписаниеОшибки());
	КонецПопытки;

	Возврат ОтветJSON(Результат);
КонецФункции

// Выполняет BSL-код (операторы) в контексте базы данных 1С.
// Использует Выполнить() - код не возвращает значение.
// Код имеет доступ к переменной Контекст (Структура) для возврата данных.
// Внутренние переменные имеют суффикс для избежания конфликта с пользовательским кодом.
//
// Параметры:
//   Запрос82746 - HTTPСервисЗапрос - входящий HTTP-запрос с JSON-телом:
//     * code - Строка - BSL-код для выполнения (операторы)
//
// Возвращаемое значение:
//   HTTPСервисОтвет - JSON с полями: success, context, duration_ms, error
//
Функция ВыполнитьPOST(Запрос82746)
	Перем Код82746, Результат82746, ВремяНачала82746;

	Код82746 = РазобратьJSON(Запрос82746.ПолучитьТелоКакСтроку());

	Если Не Код82746.Свойство("code") ИЛИ Не ЗначениеЗаполнено(Код82746.code) Тогда
		Возврат ОтветОшибка(400, "Empty code");
	КонецЕсли;

	Контекст = Новый Структура;
	ВремяНачала82746 = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Результат82746 = Новый Структура;
	Попытка
		Выполнить(Код82746.code); // BSLLS:ExecuteExternalCode-off
		Результат82746.Вставить("success", Истина);
	Исключение
		Результат82746.Вставить("success", Ложь);
		Результат82746.Вставить("error", ОписаниеОшибки());
	КонецПопытки;

	Результат82746.Вставить("duration_ms", ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала82746);
	Результат82746.Вставить("context", ПривестиЗначениеКJSON(Контекст));

	Возврат ОтветJSON(Результат82746);
КонецФункции

// Вычисляет BSL-выражение и возвращает результат.
// Использует Вычислить() - выражение должно возвращать значение.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий HTTP-запрос с JSON-телом:
//     * expression - Строка - BSL-выражение для вычисления
//
// Возвращаемое значение:
//   HTTPСервисОтвет - JSON с полями: success, result, type, error (при наличии ошибки)
//
Функция ВычислитьPOST(Запрос)
	КодОшибкиЗапроса = 400;

	Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());

	Если Не Параметры.Свойство("expression") ИЛИ Не ЗначениеЗаполнено(Параметры.expression) Тогда
		Возврат ОтветОшибка(КодОшибкиЗапроса, "Empty expression");
	КонецЕсли;

	Результат = Новый Структура;
	Попытка
		ЗначениеРезультата = Вычислить(Параметры.expression); // BSLLS:ExecuteExternalCode-off
		Результат.Вставить("success", Истина);
		Результат.Вставить("result", ПривестиЗначениеКJSON(ЗначениеРезультата));
		Результат.Вставить("type", Строка(ТипЗнч(ЗначениеРезультата)));
	Исключение
		Результат.Вставить("success", Ложь);
		Результат.Вставить("error", ОписаниеОшибки());
	КонецПопытки;

	Возврат ОтветJSON(Результат);
КонецФункции

// Читает журнал регистрации 1С через ВыгрузитьЖурналРегистрации.
// Записи возвращаются свежими первыми, число ограничено параметром limit.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий HTTP-запрос с JSON-телом:
//     * date_from - Строка - нижняя граница периода, ISO-8601 (необязательно)
//     * date_to   - Строка - верхняя граница периода, ISO-8601 (необязательно)
//     * level     - Строка - уровень: Информация/Предупреждение/Ошибка/Примечание (необязательно)
//     * user      - Строка - имя пользователя ИБ (необязательно)
//     * event     - Строка - имя события (необязательно)
//     * metadata  - Строка - полное имя объекта метаданных (необязательно)
//     * contains  - Строка - подстрока для пост-фильтра по комментарию/данным (необязательно)
//     * limit     - Число  - максимум записей (по умолчанию 100, макс 1000)
//
// Возвращаемое значение:
//   HTTPСервисОтвет - JSON с полями: columns, rows, total, truncated
//
Функция ЖурналРегистрацииPOST(Запрос)
	КодОшибкиЗапроса = 400;
	Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());

	ЛимитПоУмолчанию = 100;
	МаксимальныйЛимит = 1000;
	Лимит = ЛимитПоУмолчанию;
	Если Параметры.Свойство("limit") И Параметры.limit > 0 Тогда
		Лимит = Мин(Параметры.limit, МаксимальныйЛимит);
	КонецЕсли;

	ИменаКолонок = "Дата,Уровень,ИмяПользователя,Компьютер,ИмяПриложения,ПредставлениеПриложения,"
		+ "Событие,ПредставлениеСобытия,Комментарий,Метаданные,ПредставлениеМетаданных,"
		+ "Данные,ПредставлениеДанных,СтатусТранзакции";

	Таблица = Новый ТаблицаЗначений;
	Попытка
		// Построение отбора внутри Попытки: разбор дат и поиск объекта метаданных
		// могут бросить исключение, и клиент должен получить структурную ошибку 400.
		Отбор = ПостроитьОтборЖурнала(Параметры);
		ВыгрузитьЖурналРегистрации(Таблица, Отбор, ИменаКолонок, , Лимит);
	Исключение
		Возврат ОтветОшибка(КодОшибкиЗапроса, ОписаниеОшибки());
	КонецПопытки;

	ПодстрокаПоиска = "";
	Если Параметры.Свойство("contains") И ЗначениеЗаполнено(Параметры.contains) Тогда
		ПодстрокаПоиска = ВРег(Параметры.contains);
	КонецЕсли;

	Колонки = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;

	Строки = Новый Массив;
	// Журнал отдаёт последние Лимит записей по возрастанию времени; обходим с конца,
	// чтобы вернуть свежие события первыми.
	Индекс = Таблица.Количество() - 1;
	Пока Индекс >= 0 Цикл
		СтрокаТаблицы = Таблица[Индекс];
		Индекс = Индекс - 1;

		Если Не ПустаяСтрока(ПодстрокаПоиска) Тогда
			ТекстСтроки = ТекстДляПоиска(СтрокаТаблицы);
			Если СтрНайти(ТекстСтроки, ПодстрокаПоиска) = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Запись = Новый Массив;
		Для Каждого ИмяКолонки Из Колонки Цикл
			Запись.Добавить(ПривестиЗначениеКJSON(СтрокаТаблицы[ИмяКолонки]));
		КонецЦикла;
		Строки.Добавить(Запись);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("total", Строки.Количество());
	Результат.Вставить("truncated", Таблица.Количество() >= Лимит);

	Возврат ОтветJSON(Результат);
КонецФункции

// Возвращает объекты выбранной коллекции метаданных живой ИБ.
Функция СписокМетаданныхPOST(Запрос)
	Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());
	Если Не Параметры.Свойство("meta_type") ИЛИ ПустаяСтрока(Параметры.meta_type) Тогда
		Возврат ОтветОшибка(400, "meta_type is required");
	КонецЕсли;

	Маска = "";
	Если Параметры.Свойство("name_mask") Тогда
		Маска = ВРег(Параметры.name_mask);
	КонецЕсли;
	Лимит = 100;
	Если Параметры.Свойство("limit") И Параметры.limit > 0 Тогда
		Лимит = Мин(Параметры.limit, 1000);
	КонецЕсли;

	Попытка
		Коллекция = Метаданные[Параметры.meta_type];
	Исключение
		Возврат ОтветОшибка(400, "Unknown metadata type: " + Параметры.meta_type);
	КонецПопытки;

	Элементы = Новый Массив;
	Для Каждого Элемент Из Коллекция Цикл
		Если Не ПустаяСтрока(Маска)
			И СтрНайти(ВРег(Элемент.Имя), Маска) = 0
			И СтрНайти(ВРег(Строка(Элемент.Синоним)), Маска) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Описание = Новый Структура;
		Описание.Вставить("name", Элемент.Имя);
		Описание.Вставить("full_name", Элемент.ПолноеИмя());
		Описание.Вставить("synonym", Строка(Элемент.Синоним));
		Элементы.Добавить(Описание);
		Если Элементы.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("items", Элементы);
	Результат.Вставить("returned", Элементы.Количество());
	Результат.Вставить("truncated", Элементы.Количество() >= Лимит);
	Возврат ОтветJSON(Результат);
КонецФункции

// Возвращает основные коллекции реквизитов объекта метаданных живой ИБ.
Функция СтруктураМетаданныхPOST(Запрос)
	Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());
	Если Не Параметры.Свойство("meta_type") ИЛИ Не Параметры.Свойство("name") Тогда
		Возврат ОтветОшибка(400, "meta_type and name are required");
	КонецЕсли;

	Попытка
		Коллекция = Метаданные[Параметры.meta_type];
	Исключение
		Возврат ОтветОшибка(400, "Unknown metadata type: " + Параметры.meta_type);
	КонецПопытки;
	Попытка
		ОбъектМетаданных = Коллекция.Найти(Параметры.name);
	Исключение
		Возврат ОтветОшибка(400, "Metadata type does not support lookup: " + Параметры.meta_type);
	КонецПопытки;
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат ОтветОшибка(404, "Metadata object not found");
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("name", ОбъектМетаданных.Имя);
	Результат.Вставить("full_name", ОбъектМетаданных.ПолноеИмя());
	Результат.Вставить("synonym", Строка(ОбъектМетаданных.Синоним));
	ИменаКоллекций = Новый Массив;
	ИменаКоллекций.Добавить("СтандартныеРеквизиты");
	ИменаКоллекций.Добавить("Реквизиты");
	ИменаКоллекций.Добавить("Измерения");
	ИменаКоллекций.Добавить("Ресурсы");
	ИменаКоллекций.Добавить("ТабличныеЧасти");
	Для Каждого ИмяКоллекции Из ИменаКоллекций Цикл
		Контейнер = Новый Структура;
		Контейнер.Вставить(ИмяКоллекции);
		ЗаполнитьЗначенияСвойств(Контейнер, ОбъектМетаданных);
		КоллекцияРеквизитов = Контейнер[ИмяКоллекции];
		Если КоллекцияРеквизитов = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Элементы = Новый Массив;
		Для Каждого Элемент Из КоллекцияРеквизитов Цикл
			Описание = Новый Структура;
			Описание.Вставить("name", Элемент.Имя);
			Описание.Вставить("synonym", Строка(Элемент.Синоним));
			Если ИмяКоллекции <> "ТабличныеЧасти" Тогда
				Описание.Вставить("type", Строка(Элемент.Тип));
			КонецЕсли;
			Элементы.Добавить(Описание);
		КонецЦикла;
		Результат.Вставить(ИмяКоллекции, Элементы);
	КонецЦикла;

	Возврат ОтветJSON(Результат);
КонецФункции

#КонецОбласти
